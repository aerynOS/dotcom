---
import Default from '@astrojs/starlight/components/SiteTitle.astro';

// Get the current page URL path to determine active state
const pathname = Astro.url.pathname;

// Define your internal links here
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Download', href: '/download/' },
  { label: 'Privacy', href: '/privacy/' },
  { label: 'Sponsor', href: '/sponsor/' },
];
---

<div class="navbar-container">
  <!-- Render the default Starlight title/logo component -->
  <Default><slot /></Default>

  <!-- Add your custom internal links next to it -->
  <nav class="custom-nav">
    {navLinks.map((link) => {
      // Handle active state matching trailing slashes flexibly
      const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
      return (
        <a
          href={link.href}
          class={isActive ? 'active' : ''}
          aria-current={isActive ? 'page' : undefined}
        >
          {link.label}
        </a>
      );
    })}
  </nav>
</div>

<style>
  .navbar-container {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .custom-nav {
    display: flex;
    gap: 1.25rem;
  }
  .custom-nav a {
    text-decoration: none;
    color: var(--sl-color-text-muted);
    font-weight: 500;
    font-size: var(--sl-text-sm);
  }
  .custom-nav a:hover {
    color: var(--sl-color-text);
  }
  .custom-nav a.active {
    color: var(--sl-color-text);
    border-bottom: 2px solid var(--sl-color-accent-high);
  }

  /* Optional: Hide on small viewports if it clutters mobile header */
  @media (max-width: 50rem) {
    .custom-nav {
      display: none;
    }
  }
</style>
